# ─────────────────────────────────────────────────────────────────────────────
# Maison Lior — variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env.local` pour le développement local.
#
# La V1 (démo GitHub Pages) tourne ENTIÈREMENT en statique, en mode "mock" :
# toutes les données produits viennent de `src/data/`. Aucune de ces variables
# n'est requise pour lancer ou builder la démo.

# Source de données : "mock" (défaut) lit src/data ; "api" branchera un backend.
NEXT_PUBLIC_DATA_MODE=mock

# ─── À venir (V2) — non utilisés tant que NEXT_PUBLIC_DATA_MODE=mock ───────────
# Backend produits / stocks (ex. Supabase) :
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
#
# Paiement (ex. Stripe) :
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
